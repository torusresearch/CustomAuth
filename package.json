{
  "name": "@toruslabs/customauth",
  "version": "22.3.3",
  "description": "CustomAuth login with torus to get user private key",
  "main": "dist/lib.cjs/index.js",
  "module": "dist/lib.esm/index.js",
  "unpkg": "dist/lib.esm/index.js",
  "jsdelivr": "dist/lib.esm/index.js",
  "types": "dist/lib.cjs/index.d.ts",
  "sideEffects": false,
  "scripts": {
    "build": "vp pack",
    "prepack": "npm run build",
    "lint": "vp lint",
    "check": "vp check",
    "typecheck": "tsc --noEmit",
    "changeset": "changeset",
    "version-packages": "changeset version && npm install --package-lock-only --ignore-scripts",
    "release-packages": "changeset publish",
    "test": "vp test run",
    "prepare": "husky"
  },
  "files": [
    "dist",
    "serviceworker"
  ],
  "peerDependencies": {
    "@sentry/core": "^10.78.0"
  },
  "peerDependenciesMeta": {
    "@sentry/core": {
      "optional": true
    }
  },
  "dependencies": {
    "@chaitanyapotti/register-service-worker": "^1.7.4",
    "@toruslabs/broadcast-channel": "^14.0.0",
    "@toruslabs/constants": "^17.0.0",
    "@toruslabs/eccrypto": "^8.0.0",
    "@toruslabs/fetch-node-details": "^17.0.0",
    "@toruslabs/http-helpers": "^10.0.0",
    "@toruslabs/metadata-helpers": "^9.0.0",
    "@toruslabs/session-manager": "^6.0.0",
    "@toruslabs/torus.js": "^18.0.0",
    "bowser": "^2.15.0",
    "deepmerge": "^4.3.1",
    "events": "^3.3.0",
    "loglevel": "^1.9.2"
  },
  "devDependencies": {
    "@changesets/cli": "^3.0.3",
    "@lavamoat/harden": "^0.8.1",
    "@sentry/core": "^10.78.0",
    "@toruslabs/config": "^5.0.0",
    "@toruslabs/oxlint-config-typescript": "^1.1.0",
    "@toruslabs/torus-scripts": "9.0.1",
    "@types/events": "^3.0.3",
    "@types/node": "^26.6.6",
    "husky": "^9.1.7",
    "lint-staged": "^16.4.0",
    "typed-emitter": "^2.1.0",
    "typescript": "^7.0.2",
    "vite-plus": "1.5.0"
  },
  "overrides": {
    "vite": "npm:@voidzero-dev/vite-plus-core@1.5.0",
    "vitest": "5.1.0"
  },
  "author": "Torus Labs",
  "license": "MIT",
  "lint-staged": {
    "!(*d).{js,ts}": [
      "vp fmt",
      "vp lint --fix"
    ],
    "*.{json,md}": [
      "vp fmt"
    ]
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/torusresearch/CustomAuth.git"
  },
  "bugs": {
    "url": "https://github.com/torusresearch/CustomAuth/issues"
  },
  "homepage": "https://github.com/torusresearch/CustomAuth#readme",
  "keywords": [
    "CustomAuth",
    "customauth",
    "torus-direct-auth",
    "torus nodes",
    "torus-embed",
    "direct auth"
  ],
  "engines": {
    "node": ">=24.22.0",
    "npm": ">=12"
  },
  "devEngines": {
    "packageManager": {
      "name": "npm",
      "version": ">=11.17.0",
      "onFail": "error"
    }
  },
  "allowScripts": {
    "fsevents@2.3.3": false
  }
}
